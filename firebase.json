{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "audio-samsen",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".git/**",
        "**/.*",
        "**/*.md"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "sode-samsen-room",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".git/**",
        "**/.*",
        "**/*.md"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://audio-samsen.web.app/",
          "type": 302
        }
      ]
    }
  ]
}
